{
  "contract_version": "fabric.adapter/v1alpha2",
  "type": "workflow",
  "id": "agent-builder.simple-agent",
  "adapter_id": "nvidia.fabric.nat",
  "spec": {
    "entrypoint": {
      "kind": "factory",
      "ref": "fabric.agent.react"
    },
    "settings_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "llm_name": {
          "type": "string",
          "minLength": 1,
          "description": "Named normalized model role used by the NAT ReAct workflow."
        },
        "parse_agent_response_max_retries": {
          "type": "integer",
          "minimum": 1,
          "description": "ReAct parse retries (NAT default 1; free models need 3)."
        },
        "verbose": {
          "type": "boolean"
        }
      },
      "required": [
        "llm_name"
      ],
      "additionalProperties": false
    }
  }
}
