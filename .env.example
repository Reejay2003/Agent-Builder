# Copy to .env (make env) and fill in. NEVER commit .env. Every contributor uses their OWN keys.

# --- Local services (docker compose) ---
POSTGRES_USER=agentbuilder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentbuilder
POSTGRES_PORT=5432
VALKEY_PORT=6379

# --- LLM (BYOK, any OpenAI-compatible endpoint). Default: OpenRouter free tier ---
# Get a key at https://openrouter.ai/keys . Free models are limited (50 requests/day without credits).
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# We stay on a light/free model for now (decision in COMPLETED.md). Free models change; list tool-capable ones with:
#   curl -s https://openrouter.ai/api/v1/models | python3 -c "import json,sys;[print(m['id']) for m in json.load(sys.stdin)['data'] if m['id'].endswith(':free') and 'tools' in (m.get('supported_parameters') or [])]"
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
