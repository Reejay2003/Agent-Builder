# Copy to .env (make env) and fill in. NEVER commit .env. Every contributor uses their OWN keys.

# --- Local services (docker compose) ---
POSTGRES_USER=agentbuilder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentbuilder
POSTGRES_PORT=5432
VALKEY_PORT=6379

# --- LLM (BYOK, any OpenAI-compatible endpoint) ---
# One key variable for every provider. Examples (set all three together):
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free   (free tier: 50 requests/day)
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=<a small model id from your account>
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=<model from `ollama list`>   LLM_API_KEY=ollama
# The key goes on ONE unbroken line, no spaces or quotes. Never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Only for the OpenShell sandbox spike (spikes/s3-openshell), which uses an OpenRouter provider:
OPENROUTER_API_KEY=
